{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "name": "bastion.cms-2.1",
    "scripts": {
        "dev:site": "vite --config vite.site.config.ts",
        "dev:admin": "vite --config vite.admin.config.ts",
        "build:site": "vite build --config vite.site.config.ts",
        "build:admin": "vite build --config vite.admin.config.ts",
        "dev:all": "concurrently -k -n site,admin -c yellow,cyan \"npm:dev:site\" \"npm:dev:admin\"",
        "format": "prettier --write \"resources/**/*.{ts,vue,scss,css}\"",
        "format:check": "prettier --check \"resources/**/*.{ts,vue,scss,css}\""
    },
    "devDependencies": {
        "@pinia/colada-devtools": "^0.4.4",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/lodash": "^4.17.24",
        "@types/node": "^25.3.3",
        "@vitejs/plugin-vue": "^6.0.4",
        "@vue/tsconfig": "^0.9.0",
        "concurrently": "^9.2.1",
        "laravel-vite-plugin": "^2.1.0",
        "postcss": "^8.5.8",
        "postcss-nested": "^7.0.2",
        "prettier": "^3.8.1",
        "sass": "^1.97.3",
        "typescript": "^5.9.3",
        "vite": "^7.3.1",
        "vite-plugin-vuetify": "^2.1.3",
        "vue-tsc": "^3.2.5"
    },
    "dependencies": {
        "@mdi/font": "^7.4.47",
        "@pinia/colada": "^0.21.7",
        "@pinia/colada-plugin-cache-persister": "^0.1.3",
        "@vueuse/core": "^14.2.1",
        "axios": "^1.13.6",
        "idb-keyval": "^6.2.2",
        "lodash": "^4.17.23",
        "monaco-editor": "^0.55.1",
        "npm-check-updates": "^19.6.3",
        "pinia": "^3.0.4",
        "vee-validate": "^5.0.0-beta.0",
        "vue": "^3.5.29",
        "vue-router": "^5.0.3",
        "vuetify": "^4.0.1",
        "zod": "^4.3.6"
    },
    "overrides": {
        "@pinia/colada": "^0.21.7"
    }
}
