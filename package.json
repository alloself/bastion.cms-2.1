{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "name": "bastion.cms-2.1",
    "packageManager": "pnpm@10.31.0",
    "scripts": {
        "dev:site": "vite --config vite.site.config.ts",
        "dev:admin": "vite --config vite.admin.config.ts",
        "build:site": "vite build --config vite.site.config.ts",
        "build:admin": "vite build --config vite.admin.config.ts",
        "dev:all": "concurrently -k -n site,admin -c yellow,cyan \"pnpm:dev:site\" \"pnpm:dev:admin\"",
        "format": "prettier --write \"resources/**/*.{ts,vue,scss,css}\"",
        "format:check": "prettier --check \"resources/**/*.{ts,vue,scss,css}\""
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.2.1",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/lodash": "^4.17.24",
        "@types/node": "^25.3.5",
        "@vitejs/plugin-vue": "^6.0.4",
        "@vue/tsconfig": "^0.9.0",
        "concurrently": "^9.2.1",
        "laravel-vite-plugin": "^2.1.0",
        "npm-check-updates": "^19.6.3",
        "postcss": "^8.5.8",
        "postcss-nested": "^7.0.2",
        "prettier": "^3.8.1",
        "sass": "^1.97.3",
        "sass-embedded": "^1.97.3",
        "tailwindcss": "^4.2.1",
        "type-fest": "^4.41.0",
        "typescript": "^5.9.3",
        "vite": "^7.3.1",
        "vite-plugin-vuetify": "^2.1.3",
        "vue-tsc": "^3.2.5"
    },
    "dependencies": {
        "@fontsource/roboto": "^5.2.10",
        "@fontsource/roboto-mono": "^5.2.8",
        "@mdi/font": "^7.4.47",
        "@pinia/colada": "^1.0.0",
        "@pinia/colada-plugin-cache-persister": "0.1.4",
        "@vueuse/core": "^14.2.1",
        "axios": "^1.13.6",
        "idb-keyval": "^6.2.2",
        "lodash": "^4.17.23",
        "monaco-editor": "^0.55.1",
        "pinia": "^3.0.4",
        "vee-validate": "5.0.0-beta.0",
        "vue": "^3.5.30",
        "vue-router": "^5.0.3",
        "vuetify": "^4.0.1",
        "zod": "^4.3.6"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@parcel/watcher",
            "esbuild"
        ]
    }
}
