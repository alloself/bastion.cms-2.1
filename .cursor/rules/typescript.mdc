## Nullable типы

```ts
type TNullable<TValue> = TValue | null

type TOptional<TValue> = TValue | undefined

// Проверка
const processUser = (user: TNullable<TUser>) => {
  if (!user) {
    return
  }
  // user: TUser (сужен)
  console.log(user.name)
}
```
