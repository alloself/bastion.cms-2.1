## Type Guards — сужение типов

### Пользовательские type guards

```ts
function isUser(value: unknown): value is TUser {
  return (
    typeof value === 'object' &&
    value !== null &&
    'id' in value &&
    'name' in value
  )
}

function isNonNullable<TValue>(value: TValue): value is NonNullable<TValue> {
  return value !== null && value !== undefined
}

// Использование
const filteredUsers = items.filter(isUser)
const nonNullItems = items.filter(isNonNullable)
```

### in оператор для narrowing

```ts
interface ISuccessResponse {
  data: TUser[]
  total: number
}

interface IErrorResponse {
  error: string
  code: number
}

const handleResponse = (response: ISuccessResponse | IErrorResponse) => {
  if ('data' in response) {
    return response.data // ISuccessResponse
  }
  return response.error // IErrorResponse
}
```

### Exhaustive checking через never

```ts
enum EStatus {
  ACTIVE = 'active',
  INACTIVE = 'inactive',
  PENDING = 'pending',
}

const getStatusLabel = (status: EStatus): string => {
  switch (status) {
    case EStatus.ACTIVE:
      return 'Активен'
    case EStatus.INACTIVE:
      return 'Неактивен'
    case EStatus.PENDING:
      return 'Ожидает'
    default: {
      const exhaustiveCheck: never = status
      return exhaustiveCheck
    }
  }
}
```

