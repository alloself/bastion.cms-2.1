## Generics

### Constrained generics

```ts
interface IBaseEntity {
  id: string
  createdAt: Date
}

const findById = <TEntity extends IBaseEntity>(
  items: TEntity[],
  id: string,
): TEntity | undefined => {
  return items.find((item) => item.id === id)
}
```

### Default generic types

```ts
type TPaginatedResponse<TItem = unknown> = {
  items: TItem[]
  total: number
  page: number
  pageSize: number
}
```

### Generic composable

```ts
import { type MaybeRefOrGetter, toValue, ref, computed } from 'vue'

const useSelection = <TItem extends IBaseEntity>(
  items: MaybeRefOrGetter<TItem[]>,
) => {
  const selectedIds = ref<Set<string>>(new Set())

  const selectedItems = computed(() =>
    toValue(items).filter((item) => selectedIds.value.has(item.id)),
  )

  const toggle = (id: string) => {
    const set = new Set(selectedIds.value)
    if (set.has(id)) {
      set.delete(id)
    } else {
      set.add(id)
    }
    selectedIds.value = set
  }

  const selectAll = () => {
    selectedIds.value = new Set(toValue(items).map((item) => item.id))
  }

  const deselectAll = () => {
    selectedIds.value = new Set()
  }

  return { selectedIds, selectedItems, toggle, selectAll, deselectAll }
}
```

### Conditional types

```ts
type TExtractArrayItem<TArr> = TArr extends Array<infer TItem> ? TItem : never

type TItem = TExtractArrayItem<string[]> // string
type TNever = TExtractArrayItem<number> // never
```

